{
  "name": "@innvntory/api",
  "version": "0.0.0",
  "private": true,
  "description": "Innvntory backend service. Owns all database access and all business logic (ADR 0001).",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "db:migrate": "node src/db/migrate.ts",
    "db:check": "node src/db/check-migrations.ts"
  },
  "dependencies": {
    "@innvntory/shared": "workspace:*",
    "drizzle-orm": "0.38.4",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  }
}