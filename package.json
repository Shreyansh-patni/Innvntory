{
  "name": "innvntory",
  "version": "0.0.0",
  "private": true,
  "description": "Innvntory — AI-native inventory and business operations platform. Sahaya Technologies.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "pnpm --filter @innvntory/shared build && pnpm --filter @innvntory/api build && pnpm --filter @innvntory/web build",
    "dev": "pnpm --parallel --filter @innvntory/api --filter @innvntory/web dev",
    "dev:web": "pnpm --filter @innvntory/web dev",
    "dev:api": "pnpm --filter @innvntory/api dev",
    "lint": "pnpm --filter @innvntory/shared build && pnpm -r lint",
    "typecheck": "pnpm --filter @innvntory/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @innvntory/shared build && pnpm -r test",
    "db:migrate": "pnpm --filter @innvntory/api db:migrate",
    "db:check": "pnpm --filter @innvntory/api db:check"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}