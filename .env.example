# ==============================================================================
# INNVNTORY ENVIRONMENT CONFIGURATION
# Copy to .env.local for local development. Never commit real secrets to git.
# ==============================================================================

# --- [PUBLIC BROWSER-ACCESSIBLE VARIABLES] ---
# Base application URL for authentication redirects and callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project API URL & Public Anon Key
NEXT_PUBLIC_SUPABASE_URL=TBD
NEXT_PUBLIC_SUPABASE_ANON_KEY=TBD

# Dashboard Demo Mode (false = live truthful empty states, true = simulated operational fixtures)
NEXT_PUBLIC_DEMO_MODE=false

# --- [DEMO ACCOUNT — INTENTIONALLY PUBLIC CREDENTIALS] ---
# These are the credentials for the public Demo Workspace account.
# They grant access ONLY to the isolated Demo Workspace organization.
# Set them explicitly in Vercel environment config (not as a secret — they are public by design).
NEXT_PUBLIC_DEMO_EMAIL=demo@innvntory.com
NEXT_PUBLIC_DEMO_PASSWORD=demo@1234

# --- [SERVER-ONLY SECRETS — NEVER EXPOSE TO CLIENT] ---
# Supabase Privileged Service Role Key (Server/Migration only)
SUPABASE_SERVICE_ROLE_KEY=TBD

# Polar Billing Integration (Server-only)
POLAR_ACCESS_TOKEN=TBD
POLAR_ORGANIZATION_ID=TBD
POLAR_WEBHOOK_SECRET=TBD

# Environment Mode
NODE_ENV=development
