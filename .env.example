# Innvntory — environment variable contract
#
# This file documents the SHAPE of the environment contract only.
#
# It contains no real values, and none may ever be committed. Every real
# environment file is ignored by .gitignore; only this template is tracked.
#
# Status: the backend architecture is not yet decided
# (TBD — architectural decision required). The variables below are grouped by the
# product areas named in the product specification, not by a chosen runtime.
# Variable names are provisional and will be revised when the backend and
# deployment architecture are settled. Do not treat this as a final contract.

# Copy to .env for local use. Never copy real values into this file.
# .env is gitignored.


# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL of the deployed application. No production URL has been
# established for Innvntory.
APP_URL=

# Runtime environment name: local | development | staging | production
# (Product specification §62 requires these four to stay separate.)
APP_ENV=

# Deployment commit identifier, used to make production traceable to a commit
# (Product specification §64).
APP_COMMIT_SHA=


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The product specification (§61) names PostgreSQL as the database direction.
# Connection pooling strategy is TBD — requires architectural decision.
DATABASE_URL=
DATABASE_POOL_MAX=

# Migration tooling is not yet selected.
# DATABASE_MIGRATION_COMMAND=


# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# The product specification (§61) names Redis as the cache direction.
# Whether a separate Redis service is required is TBD — architectural decision required.
REDIS_URL=


# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# The product specification (§61) requires object storage for product images,
# invoices, documents and exports. Provider is TBD — requires architectural decision.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
# Credentials must be issued by the runtime secret manager, never hardcoded.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=


# ---------------------------------------------------------------------------
# Authentication and session
# ---------------------------------------------------------------------------
# Initial launch methods are Email + Password and Google
# (Product specification §30). Provider and session strategy are
# TBD — requires architectural decision.
AUTH_SECRET=
AUTH_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Passkey / OTP support is specified as a later option (§30). Not yet provisioned.


# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Queue / worker architecture is named in the product specification (§61).
# Implementation is TBD — requires architectural decision.
QUEUE_URL=
QUEUE_CONCURRENCY=


# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Razorpay and Stripe are named as candidate payment providers (§46).
# No provider has been selected. TBD — requires architectural decision.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Webhook idempotency is mandatory per specification §56.
# The storage design for idempotency keys is TBD — requires architectural decision.


# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
# Candidate integrations from specification §46. None are selected or enabled.
# Accounting: Tally, Zoho Books, QuickBooks
# Commerce: Shopify, WooCommerce, Amazon
# Communication: WhatsApp, Email, SMS
# Tax: GST, E-Invoice, E-Way Bill
# All integration credentials are TBD — requires architectural decision.


# ---------------------------------------------------------------------------
# AI layer
# ---------------------------------------------------------------------------
# The AI layer is not implemented and must not be implemented as part of a
# foundation task (AGENTS.md §6). No provider has been selected.
# TBD — architectural decision required.
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=


# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Logging, metrics and error reporting targets are TBD — requires architectural decision.
LOG_LEVEL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=


# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# In-app and email notifications are the initial prioritised channels (§25).
# Transactional email provider is TBD — requires architectural decision.
EMAIL_FROM=
