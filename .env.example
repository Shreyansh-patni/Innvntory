# Innvntory — environment variable contract
#
# This file documents the SHAPE of the environment contract only.
# It contains no real values, and none may ever be committed.
#
# Every real environment file is gitignored; only this template is tracked.
#
# Status: the backend service and database foundation exist as architecture and
# code (ADR 0001, ADR 0003, ADR 0004). Authentication is NOT yet specified, and
# no AI provider is selected.

# Copy to .env for local use. Never copy real values into this file.
# .env is gitignored.


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public base URL of the web frontend. No production URL has been established
# for Innvntory.
APP_URL=http://localhost:3000

# Runtime environment: local | development | staging | production
# (Product specification §62 requires these four to stay separate.)
APP_ENV=local

# Deployment commit identifier, used to make production traceable to a commit
# (Product specification §64).
APP_COMMIT_SHA=


# -----------------------------------------------------------------------------
# Backend service (ADR 0001 — dedicated backend, modular monolith)
# -----------------------------------------------------------------------------
API_PORT=4000


# -----------------------------------------------------------------------------
# Database — application runtime (ADR 0004)
# -----------------------------------------------------------------------------
# IMPORTANT — two DIFFERENT roles, deliberately (ADR 0004 Q7):
#
#   DATABASE_URL             the RUNTIME role. It must NOT own the application
#                             tables, or PostgreSQL row-level security is silently
#                             inert. Subject to RLS on every tenant-owned table.
#
#   DATABASE_MIGRATION_URL   the MIGRATION role. It owns the schema. Used only by
#                             `pnpm db:migrate`, never by a request handler.
#
# Never point the runtime role at an account that owns the tables.
DATABASE_URL=
DATABASE_MIGRATION_URL=

DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT=10

# The runtime role is created by the migration and must exist before the app
# connects. See docs/decisions/0004-orm-query-access-and-pooling.md and
# apps/api/src/db/migrations/0000_rls_foundation.sql.
DATABASE_RUNTIME_ROLE=innvntory_runtime

# Production sits behind a transaction-mode pooler such as PgBouncer (ADR 0004 Q5).
# The application is compatible with it: tenant context is set with SET LOCAL
# inside a transaction and never with session state.
DATABASE_POOLER_MODE=transaction


# -----------------------------------------------------------------------------
# Authentication — NOT YET SPECIFIED
# -----------------------------------------------------------------------------
# The auth provider and session strategy are still an open architectural decision
# (docs/ARCHITECTURE.md §15 row 4). Until that decision is made, the backend
# refuses every authenticated request rather than inventing an identity.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Queue / worker (ADR 0001 — worker in the backend)
# -----------------------------------------------------------------------------
# The worker runs as a separate process from the backend codebase. No queue
# technology has been selected yet (docs/ARCHITECTURE.md §15 row 6).
QUEUE_URL=


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
# Redis is named as the cache direction in specification §61. Whether a separate
# cache service is required is still open.
REDIS_URL=


# -----------------------------------------------------------------------------
# Object storage
# -----------------------------------------------------------------------------
# Required for product images, invoices, documents and exports (specification §61).
# Provider is not selected (docs/ARCHITECTURE.md §15 row 7).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
# Credentials must be issued by the runtime secret manager, never hardcoded.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# AI layer — NOT IMPLEMENTED
# -----------------------------------------------------------------------------
# No provider is selected. AI capability is Phase 7 (docs/ROADMAP.md).
# AI tools will call authorized backend business services only (ADR 0001 D3).
# Do not add an AI key until that architecture is built.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=


# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# In-app and email notifications are the initial prioritised channels (§25).
EMAIL_FROM=